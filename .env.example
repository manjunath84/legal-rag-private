# Copy to .env to override defaults. Everything works with NO .env (local-first).
# All settings use the RAGLAB_ prefix.

# Local LLM (OpenAI-compatible). Default points at mlx_vlm.server.
# RAGLAB_LLM_BASE_URL=http://localhost:8085/v1
# RAGLAB_LLM_MODEL=mlx-community/gemma-4-12B-it-4bit

# Local embedding model (sentence-transformers; one-time download, then offline)
# RAGLAB_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Retrieval
# RAGLAB_TOP_K=4
# RAGLAB_CHUNK_SIZE=1000
# RAGLAB_CHUNK_OVERLAP=150
