          <mxGeometry x="470" y="105" width="470" height="70" as="geometry" />
        </mxCell>

        <!-- INGESTION band -->
        <mxCell id="inglabel" value="① INGESTION  (build the index — offline)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="230" y="210" width="420" height="24" as="geometry" />
