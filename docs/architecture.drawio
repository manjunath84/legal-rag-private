        <mxCell id="ingest" value="ingest.py&#10;load → per-page text&#10;(pypdf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
