        <!-- Stage 2+ ghost box -->
        <mxCell id="stage2" value="Roadmap&#10;&#10;✓ Hybrid search (BM25 + vector, RRF)&#10;• Reranker (cross-encoder)&#10;• Section-aware chunking&#10;• Docling / unstructured parsing&#10;  (tables, layout, OCR)&#10;• Financial / medical corpora&#10;• Hugging Face Space hosting" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#666666;" vertex="1" parent="1">
