          <mxGeometry x="40" y="430" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Privacy boundary -->
        <mxCell id="boundary" value="🔒 ON-DEVICE (your laptop) — nothing leaves the machine; models were a one-time download" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#2d6a2d;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#2d6a2d;align=center;spacingTop=6;" vertex="1" parent="1">
