        <mxCell id="chunk" value="chunk.py&#10;char windows + overlap&#10;(carry source, page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
